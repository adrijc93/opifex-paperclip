{
  "name": "@opifex/paperclip-plugin-evol",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Plugin EVOL — auto-reminder post-run para registrar aprendizajes en .learnings/",
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "build:rollup": "rollup -c",
    "dev": "node ./esbuild.config.mjs --watch",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "evol",
    "learnings"
  ],
  "author": "OPIFEX",
  "license": "MIT",
  "devDependencies": {
    "@paperclipai/plugin-sdk": "file:../../sdk",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "esbuild": "^0.27.7",
    "react": "^19.2.5",
    "rollup": "^4.38.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
